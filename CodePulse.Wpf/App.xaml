<Application x:Class="CodePulse.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1113" />
            <SolidColorBrush x:Key="PanelBrush" Color="#10181B" />
            <SolidColorBrush x:Key="PanelAltBrush" Color="#152126" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1A252A" />
            <SolidColorBrush x:Key="BorderBrush" Color="#26373D" />
            <SolidColorBrush x:Key="AccentBrush" Color="#F6BE59" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FF6BE59" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F4EE" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9FB2B8" />
            <SolidColorBrush x:Key="MutedBrush" Color="#6F838A" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#35C17A" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E06868" />

            <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#121C22" Offset="0" />
                <GradientStop Color="#0F171B" Offset="0.62" />
                <GradientStop Color="#131915" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentPanelBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#111B20" Offset="0" />
                <GradientStop Color="#141A1A" Offset="1" />
            </LinearGradientBrush>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="SoftCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#101415" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="#223035" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="#33464B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#29393F" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#42575E" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="CodePulse Next"
                            IconSource="/Assets/app-icon.ico"
                            Visibility="Visible"
                            TrayLeftMouseUp="TrayIcon_OnTrayLeftMouseUp">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Opened="TrayContextMenu_OnOpened">
                        <MenuItem Header="Quick Capture"
                                  Click="QuickCaptureTrayMenuItem_OnClick" />
                        <MenuItem Header="Comments"
                                  Click="CommentsTrayMenuItem_OnClick" />
                        <MenuItem Header="Comment Timer"
                                  Click="CommentTimerTrayMenuItem_OnClick" />
                        <MenuItem Header="Send code"
                                  Click="SendCodeTrayMenuItem_OnClick" />
                        <MenuItem Header="Watch chat"
                                  Tag="WatchChat" />
                        <MenuItem Header="Boost"
                                  Tag="Boost" />
                        <MenuItem Header="Settings"
                                  Click="SettingsTrayMenuItem_OnClick" />
                        <MenuItem Header="Log view"
                                  Click="LogViewTrayMenuItem_OnClick" />
                        <MenuItem Header="Show Main Window"
                                  Click="ShowMainWindowTrayMenuItem_OnClick" />
                        <Separator />
                        <MenuItem Header="Exit"
                                  Click="ExitTrayMenuItem_OnClick" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
