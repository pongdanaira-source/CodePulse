<Window x:Class="CodePulse.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:model="clr-namespace:CodePulse.Models;assembly=CodePulse"
        xmlns:enum="clr-namespace:CodePulse.Enums;assembly=CodePulse"
        mc:Ignorable="d"
        Title="CodePulse Next"
        Icon="/Assets/app-icon.ico"
        Background="{StaticResource AppBackgroundBrush}"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource AppBackgroundBrush}"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource HeroBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left"
                                Padding="11,4"
                                Margin="0,0,0,10"
                                Background="#153A4347"
                                BorderBrush="#3C5B656A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Text="OPERATIONS SHELL" />
                        </Border>
                        <TextBlock FontSize="31"
                                   FontWeight="SemiBold"
                                   Text="CodePulse Next" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="Compact desktop shell for watch, OCR, and dispatch operations" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2"
                               VerticalAlignment="Center">
                        <Border Margin="0,0,8,0"
                                Padding="14,9"
                                Background="#20000000"
                                BorderBrush="#3A344247"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Text="Total" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Text="{Binding TotalChannels}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0"
                                Padding="14,9"
                                Background="#20000000"
                                BorderBrush="#3A344247"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Text="Enabled" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Text="{Binding EnabledChannels}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0"
                                Padding="14,9"
                                Background="#20000000"
                                BorderBrush="#3A344247"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Text="Ready" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Text="{Binding ReadyChannels}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="14,9"
                                Background="#20000000"
                                BorderBrush="#3A344247"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Text="Watching" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Text="{Binding WatchingChannels}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Column="4"
                                VerticalAlignment="Center">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Margin="0,0,8,8"
                                    Click="QuickCaptureButton_OnClick">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE722;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Quick capture" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8"
                                    Click="CommentScannerButton_OnClick">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE8BD;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Comments" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8"
                                    Click="RefreshButton_OnClick">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE72C;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8"
                                    Click="AddChannelButton_OnClick">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE710;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Add" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,0,8"
                                    Click="SettingsButton_OnClick">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE713;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Settings" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="{Binding SettingsPath}"
                                   TextTrimming="CharacterEllipsis"
                                   Width="290" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.98*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <Grid Margin="18,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Text="Channels" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="Sorted for quick watch, OCR, and dispatch checks." />
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right">
                            <Button Margin="0,0,8,8"
                                    Click="EditChannelButton_OnClick"
                                    IsEnabled="{Binding CanEditSelectedChannel}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE70F;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Edit" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,0,8"
                                    Click="RemoveSelectedButton_OnClick"
                                    IsEnabled="{Binding CanRemoveSelectedChannel}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE74D;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Remove" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="22,0,26,8"
                          IsHitTestVisible="False"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.72*" />
                            <ColumnDefinition Width="1.62*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Channel" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Prefix" />
                        <TextBlock Grid.Column="2"
                                   Margin="22,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Status" />
                        <TextBlock Grid.Column="3"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Boost" />
                    </Grid>

                    <ListView Grid.Row="1"
                              Margin="10,4,10,10"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding SelectedChannel, Mode=TwoWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemRoot"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    CornerRadius="16">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#0CFFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#16F2B84B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:ChannelProfile}">
                                <Border x:Name="RowCard"
                                        Padding="18,13"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.05*" />
                                            <ColumnDefinition Width="1.55*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center" />
                                                <WrapPanel Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ItemHeight="22">
                                                    <Border x:Name="WatchBadge"
                                                            Margin="0,0,6,0"
                                                            Padding="8,3"
                                                            Background="#1E35C17A"
                                                            BorderBrush="#3A35C17A"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Visibility="Collapsed"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Margin="0,0,5,0"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource SuccessBrush}"
                                                                       Text="&#xE768;"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SuccessBrush}"
                                                                       Text="{Binding WatchBadgeText}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="ScanBadge"
                                                            Margin="0,0,6,0"
                                                            Padding="8,3"
                                                            Background="#1EF6BE59"
                                                            BorderBrush="#3AF6BE59"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Visibility="Collapsed"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Margin="0,0,5,0"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       Text="&#xE8B6;"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       Text="{Binding ScanBadgeText}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="CommentBadge"
                                                            Margin="0,0,6,0"
                                                            Padding="8,3"
                                                            Background="#1A78C4FF"
                                                            BorderBrush="#3A78C4FF"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Visibility="Collapsed"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Margin="0,0,5,0"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Foreground="#9FD0FF"
                                                                       Text="&#xE8BD;"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#9FD0FF"
                                                                       Text="Comments"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="StatusBadge"
                                                            Margin="0,0,6,0"
                                                            Padding="8,3"
                                                            Background="#182D3940"
                                                            BorderBrush="#3046525A"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Visibility="Collapsed"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock x:Name="StatusBadgeIcon"
                                                                       Margin="0,0,5,0"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="&#xE946;"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock x:Name="StatusBadgeTextBlock"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding StatusBadgeText}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Text="{Binding ChatLink}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <Border
                                                    MinWidth="54"
                                                    MaxWidth="250"
                                                    Padding="9,4"
                                                    Background="#24373C2C"
                                                    BorderBrush="#34555D46"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding PrefixDisplay}"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Margin="14,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="BoostButton"
                                                    MinWidth="96"
                                                    Padding="10,7"
                                                    Click="BoostChannelButton_OnClick"
                                                    Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Margin="0,0,7,0"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Text="&#xE945;" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{Binding BoostButtonText}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBoosting}" Value="True">
                                        <Setter TargetName="RowCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="RowCard" Property="Background" Value="#202A2218" />
                                        <Setter TargetName="BoostButton" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="BoostButton" Property="Foreground" Value="#101415" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWatchActive}" Value="True">
                                        <Setter TargetName="WatchBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScanActive}" Value="True">
                                        <Setter TargetName="ScanBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCommentScanActive}" Value="True">
                                        <Setter TargetName="CommentBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStatusBadgeVisible}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enum:SessionState.Idle}">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#1A243542" />
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#3242525F" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Foreground" Value="#9FD0FF" />
                                        <Setter TargetName="StatusBadgeTextBlock" Property="Foreground" Value="#9FD0FF" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Text" Value="&#xE73E;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enum:SessionState.Stopped}">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#1A374046" />
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#33475057" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter TargetName="StatusBadgeTextBlock" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Text" Value="&#xE71A;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enum:SessionState.Ended}">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#1A4C3D26" />
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#43684F2E" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="StatusBadgeTextBlock" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Text" Value="&#xE8BB;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enum:SessionState.Error}">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#22E06868" />
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#44E06868" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter TargetName="StatusBadgeTextBlock" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter TargetName="StatusBadgeIcon" Property="Text" Value="&#xEA39;" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource AccentPanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Text="Selected channel" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedChannel.Name, TargetNullValue=No channel selected}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="{Binding SelectedChannelAvailabilityText}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Chat link" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="{Binding SelectedChannelLink}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Prefixes" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" FontSize="12" Text="{Binding SelectedChannelPrefixes}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Capture" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" FontSize="12" Text="{Binding SelectedChannelCaptureText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Scan interval" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" FontSize="12" Text="{Binding SelectedChannelScanText}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Latest status" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" FontSize="12" Text="{Binding SelectedChannelStatus}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Actions" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="Run watch and OCR controls for the selected channel." />
                        <UniformGrid Margin="0,16,0,0"
                                     Columns="2">
                            <Button Margin="0,0,8,8"
                                    Click="StartSelectedButton_OnClick"
                                    IsEnabled="{Binding CanStartSelectedWatch}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE768;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Start selected" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,0,0,8"
                                    Click="StopSelectedButton_OnClick"
                                    IsEnabled="{Binding CanStopSelectedWatch}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE71A;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Stop selected" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,8,8,0"
                                    Click="CaptureSelectedButton_OnClick"
                                    IsEnabled="{Binding CanCaptureSelected}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE722;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Capture" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,8,0,0"
                                    Click="StartSelectedOcrButton_OnClick"
                                    IsEnabled="{Binding CanStartSelectedOcrScan}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE8B6;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Start OCR" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,8,8,0"
                                    Click="StopSelectedOcrButton_OnClick"
                                    IsEnabled="{Binding CanStopSelectedOcrScan}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE71A;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Stop OCR" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,8,0,0"
                                    Click="StopAllButton_OnClick"
                                    IsEnabled="{Binding CanStopAnyWatch}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Text="&#xE711;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Stop all" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="Live log" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="{Binding LogEntryCount, StringFormat={}{0} entries in the current live feed}" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1"
                                       HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0"
                                        Padding="12,8"
                                        Click="CopyLogButton_OnClick">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,7,0"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE8C8;" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Copy log" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,8"
                                        Click="ClearLogButton_OnClick">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,7,0"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE74D;" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Clear" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="LogListBox"
                                 Margin="10,0,10,10"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding LogEntries}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type model:AppLogEntry}">
                                    <Border x:Name="LogCard"
                                            Margin="0,0,0,8"
                                            Padding="9"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <DockPanel>
                                            <Border x:Name="LogTimeBadge"
                                                    DockPanel.Dock="Left"
                                                    Margin="0,0,10,0"
                                                    Padding="8,3"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="#00000000"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <TextBlock Width="56"
                                                           HorizontalAlignment="Center"
                                                           x:Name="LogTimeText"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                            </Border>
                                            <TextBlock x:Name="LogMessageText"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Text="{Binding Message}" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding UseAccentStyle}" Value="True">
                                            <Setter TargetName="LogCard" Property="Background" Value="#1F2A23" />
                                            <Setter TargetName="LogCard" Property="BorderBrush" Value="#3D5B4D" />
                                            <Setter TargetName="LogTimeBadge" Property="Background" Value="#24373C2C" />
                                            <Setter TargetName="LogTimeBadge" Property="BorderBrush" Value="#34555D46" />
                                            <Setter TargetName="LogTimeText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="LogMessageText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="LogMessageText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
