<Window x:Class="CodePulse.Wpf.Windows.LineWindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick LINE Window"
        Icon="/Assets/app-icon.ico"
        Width="620"
        Height="460"
        MinWidth="540"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeroBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="20">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="Pick LINE Window" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Choose the exact LINE chat window CodePulse may paste into. This target is kept only until CodePulse exits."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="10">
            <ListBox x:Name="WindowsListBox"
                     BorderThickness="0"
                     Background="Transparent"
                     MouseDoubleClick="WindowsListBox_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="14"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="{Binding Detail}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Width="108"
                        Margin="0,0,10,0"
                        Click="RefreshButton_OnClick"
                        Content="Refresh" />
                <Button Width="108"
                        Margin="0,0,10,0"
                        Click="CancelButton_OnClick"
                        Content="Cancel" />
                <Button Width="136"
                        Click="UseSelectedButton_OnClick"
                        Content="Use this window"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
