<Window x:Class="CodePulse.Wpf.Windows.ChannelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Channel editor"
        Icon="/Assets/app-icon.ico"
        Width="680"
        Height="760"
        MinWidth="620"
        MinHeight="700"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeroBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="22">
            <StackPanel>
                <Border HorizontalAlignment="Left"
                        Padding="11,4"
                        Background="#153A4347"
                        BorderBrush="#3C5B656A"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Text="Channel setup" />
                </Border>
                <TextBlock Margin="0,16,0,0"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="Channel details" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Text="Define how this channel is watched, matched by prefix rules, and scanned inside the new shell." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Name" />
                    <TextBox x:Name="NameTextBox"
                             Margin="0,8,0,0" />

                    <TextBlock Margin="0,18,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Watch source" />
                    <TextBox x:Name="ChatLinkTextBox"
                             Margin="0,8,0,0" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="Use a YouTube live_chat link, a normal watch URL, or a YouTube channel ID that starts with UC. If the channel is not live, Start will stop immediately." />

                    <TextBlock Margin="0,18,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Prefixes" />
                    <TextBox x:Name="PrefixesTextBox"
                             Margin="0,8,0,0"
                             MinHeight="118"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="Use one prefix per line. Formats: PREFIX or PREFIX:8. If no prefix matches, generic fallback now checks length 10 only." />

                    <Border Margin="0,20,0,0"
                            Style="{StaticResource SoftCardBorderStyle}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Behavior" />
                            <CheckBox x:Name="EnabledCheckBox"
                                      Margin="0,16,0,0"
                                      Content="Channel enabled" />
                            <CheckBox x:Name="PrefixOnlyCheckBox"
                                      Margin="0,12,0,0"
                                      Content="Prefix only (disable generic 10-character fallback)" />
                            <CheckBox x:Name="EnableAutoScanCheckBox"
                                      Margin="0,12,0,0"
                                      Content="Enable OCR auto-scan for this channel" />

                            <TextBlock Margin="0,18,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Auto-scan interval (ms)" />
                            <TextBox x:Name="AutoScanIntervalTextBox"
                                     Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4">
            <Border x:Name="ValidationBorder"
                    DockPanel.Dock="Left"
                    MaxWidth="360"
                    Background="#22E06868"
                    BorderBrush="#40E06868"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="ValidationTextBlock"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Width="120"
                        Margin="0,0,10,0"
                        Click="CancelButton_OnClick"
                        Content="Cancel" />
                <Button Width="120"
                        Click="SaveButton_OnClick"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
