<Window x:Class="CodePulse.Wpf.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="/Assets/app-icon.ico"
        Width="860"
        Height="900"
        MinWidth="780"
        MinHeight="780"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeroBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border HorizontalAlignment="Left"
                            Padding="11,4"
                            Background="#153A4347"
                            BorderBrush="#3C5B656A"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="SYSTEM SETTINGS" />
                    </Border>
                    <TextBlock Margin="0,14,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="Dispatch and OCR" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Text="Keep only the controls that still affect live dispatch, desktop automation, and OCR fallback behavior."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="20,0,0,0"
                        Background="#16000000"
                        BorderBrush="#2E3D4348"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Text="Active scope" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="New shell" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="Telegram, LINE, Facebook, alert sound, and OCR fallback settings are applied through the shared app settings store."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Telegram" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="Bot credentials for direct Telegram dispatch." />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="Bot token" />
                                <TextBox x:Name="TelegramBotTokenTextBox"
                                         Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="Chat ID" />
                                <TextBox x:Name="TelegramChatIdTextBox"
                                         Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Desktop dispatch" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="Toggles and safety controls for LINE and Facebook automation." />

                        <WrapPanel Margin="0,18,0,0">
                            <CheckBox x:Name="EnableSoundCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Alert sound" />
                            <CheckBox x:Name="EnableLineCheckBox"
                                      Margin="0,0,22,12"
                                      Content="LINE dispatch" />
                            <CheckBox x:Name="EnableFacebookCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Facebook dispatch" />
                            <CheckBox x:Name="SkipIfWindowNotFoundCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Skip if window is missing" />
                            <CheckBox x:Name="EnterAfterPasteCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Press Enter after paste" />
                            <CheckBox x:Name="EnableDryRunCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Dry run mode" />
                            <CheckBox x:Name="SendManualCaptureImageCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Send manual capture image" />
                            <CheckBox x:Name="SaveManualCaptureImageToTempInDryRunCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Save manual capture image to Temp in dry run" />
                        </WrapPanel>

                        <Border Margin="0,8,0,0"
                                Background="#111A1D"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="LINE target window" />
                                    <TextBlock x:Name="LineTargetWindowTextBlock"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               Text="Session only. CodePulse clears this target when the app closes."
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Width="150"
                                        VerticalAlignment="Center"
                                        Click="PickLineWindowButton_OnClick"
                                        Content="Pick LINE window" />
                                <Button Grid.Column="3"
                                        Width="92"
                                        VerticalAlignment="Center"
                                        Click="ClearLineWindowButton_OnClick"
                                        Content="Clear" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Text="Test dispatch is always a dry-run. Facebook can be locked to a Messenger room URL; if the URL is configured and not open, Facebook dispatch is skipped."
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="Paste delay (ms)" />
                                <TextBox x:Name="PasteDelayTextBox"
                                         Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="Facebook Messenger target URL" />
                                <TextBox x:Name="FacebookTargetUrlTextBox"
                                         Margin="0,8,0,0" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           Text="Example: https://www.facebook.com/messages/t/26657469643882596"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="YouTube watch source" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="API key used to resolve YouTube channel IDs (UC...) to the current live stream before watcher startup." />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="YouTube Data API key" />
                                <TextBox x:Name="YouTubeApiKeyTextBox"
                                         Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="Boost timeout (sec)" />
                                <TextBox x:Name="BoostTimeoutTextBox"
                                         Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,18,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="Backup API keys" />
                        <UniformGrid x:Name="YouTubeBackupKeysGrid"
                                     Margin="0,8,0,0"
                                     Columns="2" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="OCR fallback" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Text="Debug output and OCR.space fallback controls used by the current OCR workflow." />

                        <WrapPanel Margin="0,18,0,0">
                            <CheckBox x:Name="EnableOcrDebugLogCheckBox"
                                      Margin="0,0,22,12"
                                      Content="OCR debug log" />
                            <CheckBox x:Name="EnableOcrSpaceFallbackCheckBox"
                                      Margin="0,0,22,12"
                                      Content="Enable OCR.space fallback" />
                        </WrapPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="OCR.space API key" />
                                <TextBox x:Name="OcrSpaceApiKeyTextBox"
                                         Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="Language" />
                                <TextBox x:Name="OcrSpaceLanguageTextBox"
                                         Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusTextBlock"
                       Visibility="Collapsed" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Width="116"
                        Margin="0,0,10,0"
                        Click="ImportButton_OnClick"
                        Content="Import" />
                <Button Width="116"
                        Margin="0,0,10,0"
                        Click="ExportButton_OnClick"
                        Content="Export" />
                <Button Width="138"
                        Margin="0,0,10,0"
                        Click="TestDispatchButton_OnClick"
                        Content="Dry-run test" />
                <Button Width="116"
                        Margin="0,0,10,0"
                        Click="CancelButton_OnClick"
                        Content="Cancel" />
                <Button Width="116"
                        Click="SaveButton_OnClick"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
