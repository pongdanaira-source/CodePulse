<Window x:Class="CodePulse.Wpf.Windows.CommentTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comment Timer"
        Icon="/Assets/app-icon.ico"
        Width="820"
        MinWidth="760"
        Height="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Margin="14"
            Padding="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="16,16,16,0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            Background="#153A4347"
                            BorderBrush="#3C5B656A"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="COMMENT TIMER" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Ready" />
                        <TextBlock Text="  " />
                        <TextBlock x:Name="StatusHintTextBlock"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Text="Schedule owner-comment scans."
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="16,0,16,0"
                    Padding="14"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0">
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Channel" />
                        <ComboBox x:Name="ChannelComboBox"
                                  Margin="0,7,0,0"
                                  MinHeight="38"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="Editor_OnChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="2">
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Start" />
                        <TextBox x:Name="StartTimeTextBox"
                                 Margin="0,7,0,0"
                                 MinHeight="38"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 TextChanged="Editor_OnTextChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="4">
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Timeout" />
                        <ComboBox x:Name="DurationComboBox"
                                  Margin="0,7,0,0"
                                  MinHeight="38"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Seconds"
                                  SelectionChanged="Editor_OnChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="6">
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Poll" />
                        <ComboBox x:Name="PollIntervalComboBox"
                                  Margin="0,7,0,0"
                                  MinHeight="38"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Seconds"
                                  SelectionChanged="Editor_OnChanged" />
                    </StackPanel>

                    <CheckBox x:Name="EnabledCheckBox"
                              Grid.Row="0"
                              Grid.Column="8"
                              Margin="0,24,0,0"
                              VerticalAlignment="Top"
                              Content="Enabled"
                              IsChecked="True"
                              Checked="Editor_OnChanged"
                              Unchecked="Editor_OnChanged" />

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Text="Video URL or ID" />
                            <Border Grid.Column="1"
                                    Padding="8,3"
                                    Background="#182D3940"
                                    BorderBrush="#3046525A"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Text="stop on first new code" />
                            </Border>
                        </Grid>
                        <TextBox x:Name="VideoUrlTextBox"
                                 Margin="0,7,0,0"
                                 MinHeight="40"
                                 Padding="12,8"
                                 VerticalContentAlignment="Center"
                                 TextChanged="Editor_OnTextChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Margin="16,0,16,0"
                    Padding="10"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <ListBox x:Name="TimerListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="TimerListBox_OnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="0.65*" />
                                        <ColumnDefinition Width="0.65*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding ChannelName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Text="{Binding StartTime}" />
                                    <TextBlock Grid.Column="2"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Text="{Binding DurationText}" />
                                    <TextBlock Grid.Column="3"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Text="{Binding PollText}" />
                                    <TextBlock Grid.Column="4"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding EnabledText}" />
                                    <TextBlock Grid.Column="5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Text="{Binding Status}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="6"
                    Margin="16,0,16,16"
                    Padding="14,12,14,14"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Text="One channel can have multiple scheduled timers."
                               TextWrapping="Wrap" />

                    <Button Grid.Column="1"
                            Width="86"
                            Padding="12,9"
                            Click="NewButton_OnClick"
                            Content="New" />
                    <Button Grid.Column="3"
                            x:Name="DeleteButton"
                            Width="86"
                            Padding="12,9"
                            Click="DeleteButton_OnClick"
                            Content="Delete" />
                    <Button Grid.Column="5"
                            x:Name="StartNowButton"
                            Width="96"
                            Padding="12,9"
                            Click="StartNowButton_OnClick"
                            Content="Start now" />
                    <Button Grid.Column="7"
                            x:Name="StopButton"
                            Width="86"
                            Padding="12,9"
                            Click="StopButton_OnClick"
                            Content="Stop" />
                    <Button Grid.Column="9"
                            Width="86"
                            Padding="12,9"
                            Click="CloseButton_OnClick"
                            Content="Close" />
                    <Button Grid.Column="11"
                            x:Name="SaveButton"
                            Width="96"
                            Padding="12,9"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveButton_OnClick"
                            Content="Save" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
