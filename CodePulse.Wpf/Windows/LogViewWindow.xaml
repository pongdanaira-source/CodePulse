<Window x:Class="CodePulse.Wpf.Windows.LogViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:CodePulse.Models;assembly=CodePulse"
        Title="CodePulse Log View"
        Icon="/Assets/app-icon.ico"
        Background="{StaticResource AppBackgroundBrush}"
        Width="980"
        Height="680"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource AppBackgroundBrush}"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Log view" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Text="{Binding LogEntryCount, StringFormat={}{0} entries in the current live feed}" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Padding="12,8"
                            Click="CopyLogButton_OnClick">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,7,0"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="&#xE8C8;" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="Copy log" />
                        </StackPanel>
                    </Button>
                    <Button Padding="12,8"
                            Click="ClearLogButton_OnClick">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,7,0"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="&#xE74D;" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="Clear" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">
                <ListBox x:Name="LogListBox"
                         Margin="10"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding LogEntries}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:AppLogEntry}">
                            <Border x:Name="LogCard"
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <DockPanel LastChildFill="True">
                                    <Border x:Name="LogTimeBadge"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,12,0"
                                            Padding="9,4"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="#00000000"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <TextBlock x:Name="LogTimeText"
                                                   Width="60"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                    </Border>
                                    <TextBlock x:Name="LogMessageText"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding UseAccentStyle}" Value="True">
                                    <Setter TargetName="LogCard" Property="Background" Value="#1F2A23" />
                                    <Setter TargetName="LogCard" Property="BorderBrush" Value="#3D5B4D" />
                                    <Setter TargetName="LogTimeBadge" Property="Background" Value="#24373C2C" />
                                    <Setter TargetName="LogTimeBadge" Property="BorderBrush" Value="#34555D46" />
                                    <Setter TargetName="LogTimeText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="LogMessageText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="LogMessageText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</Window>
