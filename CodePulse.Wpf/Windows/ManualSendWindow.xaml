<Window x:Class="CodePulse.Wpf.Windows.ManualSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Send"
        Icon="/Assets/app-icon.ico"
        Width="640"
        MinWidth="560"
        Height="570"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Margin="14"
            Padding="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="16,16,16,0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            Background="#153A4347"
                            BorderBrush="#3C5B656A"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="MANUAL DISPATCH" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Ready" />
                        <TextBlock Text="  "
                                   FontSize="12" />
                        <TextBlock x:Name="StatusHintTextBlock"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Text="Paste a code or message."
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="260" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.88*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Channel" />
                        <ComboBox x:Name="ChannelComboBox"
                                  Margin="0,8,0,0"
                                  MinHeight="40"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="ChannelComboBox_OnSelectionChanged" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="14"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Default rule" />
                        <TextBlock x:Name="SelectedPrefixModeTextBlock"
                                   Margin="0,9,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Margin="16,0,16,0"
                    Padding="14"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Code or source message" />
                        <Border Grid.Column="1"
                                Padding="8,3"
                                Background="#182D3940"
                                BorderBrush="#3046525A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Text="prefix-aware" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            MinHeight="42"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="#33464B"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBox x:Name="InputTextBox"
                                 MinHeight="40"
                                 Padding="12,8"
                                 AcceptsReturn="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Center"
                                 KeyDown="InputTextBox_OnKeyDown"
                                 TextChanged="InputTextBox_OnTextChanged" />
                    </Border>

                    <StackPanel Grid.Row="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Text="Channel prefixes" />
                            <Button Grid.Column="1"
                                    Padding="8,3"
                                    FontSize="11"
                                    Click="CopyPrefixButton_OnClick"
                                    Content="Copy" />
                        </Grid>
                        <TextBox x:Name="SelectedPrefixTextBlock"
                                 Margin="0,5,0,0"
                                 Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="12"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap" />
                    </StackPanel>

                    <Border Grid.Row="6"
                            Padding="12"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Text="Preview" />
                            <TextBlock x:Name="PreviewTextBlock"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Margin="16,0,16,16"
                    Padding="14,12,14,14"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Text="Duplicate guard and normal dispatch pipeline are applied."
                               TextWrapping="Wrap" />

                    <Button Grid.Column="1"
                            Width="108"
                            Padding="18,9"
                            Click="CloseButton_OnClick"
                            Content="Close" />

                    <Button Grid.Column="3"
                            x:Name="SendButton"
                            Width="128"
                            Padding="18,9"
                            Style="{StaticResource AccentButtonStyle}"
                            IsDefault="True"
                            Click="SendButton_OnClick"
                            Content="Send" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
